          "legendFormat": "vLLM",
          "refId": "A"
        },
        {
          "expr": "\n                    (\n                      sum(rate(ray_serve_http_request_latency_ms_sum[5m]))\n                      /\n                      sum(rate(ray_serve_http_request_latency_ms_count[5m]))\n                    ) / 1000\n                    ",
          "legendFormat": "HTTP",
          "refId": "B"
        }
