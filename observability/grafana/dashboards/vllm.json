      "targets": [
        {
          "expr": "\n                    sum(rate(ray_vllm_request_prefill_time_seconds_sum[5m]))\n                    /\n                    sum(rate(ray_vllm_request_prefill_time_seconds_count[5m]))\n                    ",
          "legendFormat": "prefill",
          "refId": "A"
